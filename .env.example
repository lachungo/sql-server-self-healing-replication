# Copy to .env and set real values. Avoid single quotes in passwords (they are injected into T-SQL).
SA_PASSWORD=ChangeMe_Str0ng!Pass
DIST_ADMIN_PASSWORD=ChangeMe_D1st!Admin

# Optional cloud subscriber (leave MI_SUBSCRIBER empty to build the on-prem tier only).
# Use the PUBLIC endpoint form: <mi-name>.public.<dns-zone>.database.windows.net,3342
MI_SUBSCRIBER=
MI_LOGIN=repladmin
MI_PASSWORD=
